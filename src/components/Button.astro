---
import { cn } from "@lib/cn";

interface Props {
  variant?: "primary" | "secondary" | "outline";
  size?: "sm" | "md" | "lg";
  href?: string;
  class?: string;
  disabled?: boolean;
  ariaLabel?: string;
}

const {
  variant = "primary",
  size = "md",
  href,
  class: className,
  disabled = false,
  ariaLabel,
} = Astro.props;

const baseStyles =
  "font-semibold rounded-lg transition-all duration-300 inline-flex items-center justify-center";

const variantStyles = {
  primary: "bg-blue-600 text-white hover:bg-blue-700 active:scale-95",
  secondary: "bg-orange-500 text-white hover:bg-orange-600 active:scale-95",
  outline:
    "border-2 border-blue-600 text-blue-600 hover:bg-blue-50 active:scale-95",
};

const sizeStyles = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3 text-base",
  lg: "px-8 py-4 text-lg",
};

const disabledStyles = disabled ? "opacity-50 cursor-not-allowed" : "";

const classes = cn(
  baseStyles,
  variantStyles[variant],
  sizeStyles[size],
  disabledStyles,
  className
);

const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  disabled={disabled}
  aria-label={ariaLabel}
  class={classes}
>
  <slot />
</Tag>
